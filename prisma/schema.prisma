// Prisma schema for TutorCarePoint — a free, mediated tuition-matching
// site for all of Bangladesh, launching in Sirajganj district first.
// PostgreSQL (Neon / Supabase free tier). See README.md for setup.
//
// Model overview:
//   User         — auth account; role is TUTOR or ADMIN.
//   TutorProfile — a tutor's public listing (education, subjects, areas).
//                  Phone is private: never shown publicly.
//   Job          — a guardian's tuition requirement. Guardian phone is
//                  private: shown to admin always, and to a tutor only when
//                  that tutor's application is CONFIRMED.
//   Application  — a tutor's application to a job, moving through the
//                  mediation pipeline: APPLIED -> SHORTLISTED -> DEMO ->
//                  CONFIRMED -> COMPLETED (or CANCELLED).
//
// There is NO money in this product: no payment, commission, fee, or
// gateway model exists anywhere in the schema — by design.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and
// in the PrismaPg adapter (lib/prisma.ts) for the runtime client — NOT here.
datasource db {
  provider = "postgresql"
}

enum Role {
  TUTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  ANY
}

enum Medium {
  BANGLA
  ENGLISH_MEDIUM
  ENGLISH_VERSION
  MADRASA
}

enum JobStatus {
  PENDING_REVIEW
  OPEN
  FILLED
  EXPIRED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  DEMO
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models — required by @auth/prisma-adapter.
// Sessions use the JWT strategy (see auth.ts), so the Session table is kept
// for adapter compatibility but is not used at runtime.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(TUTOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  tutorProfile TutorProfile?

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Tuition models
// ---------------------------------------------------------------------------

model TutorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  gender          Gender   @default(ANY)
  // Private: shown to admin always, and to a guardian only after the
  // tutor is confirmed for that guardian's job. Never public.
  phone           String
  district        String // slug key, see DISTRICTS in lib/site.ts
  area            String? // upazila / neighbourhood, free text
  educationLevel  String // e.g. "অনার্স ৩য় বর্ষ" or "বিএসসি সম্পন্ন"
  institution     String?
  subjects        String[]
  classes         String[]
  mediums         Medium[]
  expectedSalary  Int? // monthly, BDT; null = negotiable
  daysPerWeek     Int?
  experienceYears Int      @default(0)
  bio             String?  @db.Text
  isVerified      Boolean  @default(false)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications Application[]

  @@index([district, isPublished])
  @@index([isPublished, isVerified])
}

model Job {
  id      String @id @default(cuid())
  // Guardian details — private. Shown to admin always; to a tutor only
  // when that tutor's application is CONFIRMED. Never public.
  guardianName  String
  guardianPhone String
  // Generated by the server from class + subjects + upazila.
  title             String
  className         String // e.g. "৮ম শ্রেণি", "এইচএসসি ১ম বর্ষ"
  subjects          String[]
  medium            Medium    @default(BANGLA)
  district          String // slug key, see DISTRICTS in lib/site.ts
  area              String? // upazila / neighbourhood, free text
  salary            Int? // monthly, BDT; null = negotiable
  salaryNegotiable  Boolean   @default(false)
  daysPerWeek       Int       @default(5)
  tutorGenderPreference Gender @default(ANY)
  notes             String?   @db.Text
  status            JobStatus @default(PENDING_REVIEW)
  // Set when admin approves the post. Public expiry is 30 days after this.
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  applications Application[]

  @@index([status, publishedAt])
  @@index([district, status])
}

model Application {
  id        String            @id @default(cuid())
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tutorId   String
  tutor     TutorProfile      @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(APPLIED)
  note      String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([jobId, tutorId])
  @@index([tutorId, status])
  @@index([jobId, status])
}
