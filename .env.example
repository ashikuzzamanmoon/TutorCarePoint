# Copy this file to `.env` (local) and fill in real values.
# On Vercel, set the same variables in Project Settings -> Environment Variables.
# NEVER commit a real `.env` file.

# PostgreSQL connection string (Neon or Supabase free tier).
# Neon example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/tutorcarepoint?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/tutorcarepoint?sslmode=require"

# Auth.js secret. Generate one with: openssl rand -base64 32
AUTH_SECRET="your-32-byte-base64-secret-here"

# Canonical URL of the app (used by Auth.js for callbacks).
# Local: http://localhost:3000 — Production: https://your-domain.vercel.app
AUTH_URL="http://localhost:3000"

# Public base URL, used for absolute links in pages.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth Credentials (Google Cloud Console / Auth.js)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Email Delivery (Option 1: Free Gmail SMTP — recommended if no custom domain)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Email Delivery (Option 2: Resend API Key — https://resend.com)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="TutorCarePoint <onboarding@resend.dev>"
